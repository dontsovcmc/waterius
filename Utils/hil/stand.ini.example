; Скопируйте в stand.ini и поправьте под свой стенд.
; Любое значение перекрывается переменной окружения: HIL_METF_HOST и т.п.

[metf]
host = 192.168.51.250
button_pin = 1
ch0_pin = 3
ch1_pin = 2
reset_pin = 0

[router]
; Сетевая консоль WT32-ETH01 по Ethernet: стенд гасит Wi-Fi, поэтому управление
; идёт по проводу. Пароль тот же, что у веб-интерфейса платы. См. wt32-eth01.md.
host = 192.168.50.236
password =
; USB-TTL. Оставить ПУСТЫМ: connect() предпочитает port над host и молча уведёт
; управление на провод. Нужен только для восстановления немой платы.
port =

[dut]
; MAC Ватериуса: под него закрепляется адрес, чтобы правила фильтра были стабильны.
mac = 00:00:00:00:00:00
ip = 192.168.4.100

[receiver]
; Адрес, который прописан в настройках Ватериуса как «свой сервер».
host = 192.168.4.2
port = 8000

[broker]
host = 192.168.4.2
port = 1883
topic = waterius

[atboard]
; NodeMCU с прошивкой ESP-AT: единственный, кто может зайти в сеть портала
; Ватериуса. Пусто - тесты портала пропускаются. Прошивка - nodemcu-at.md.
port =
