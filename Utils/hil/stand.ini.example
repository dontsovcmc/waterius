; Скопируйте в stand.ini и поправьте под свой стенд.
; Любое значение перекрывается переменной окружения: HIL_METF_HOST и т.п.

[metf]
host = 192.168.51.250
button_pin = 1
ch0_pin = 3
ch1_pin = 2
reset_pin = 0

[router]
; USB-TTL к консоли WT32-ETH01. Своего USB у платы нет.
port = /dev/cu.usbserial-XXXX
; Запасной путь - сетевая консоль. Пароль тот же, что у веб-интерфейса.
host =
password =

[dut]
; MAC Ватериуса: под него закрепляется адрес, чтобы правила фильтра были стабильны.
mac = 00:00:00:00:00:00
ip = 192.168.4.100

[receiver]
; Адрес, который прописан в настройках Ватериуса как «свой сервер».
host = 192.168.4.2
port = 8000

[broker]
host = 192.168.4.2
port = 1883
topic = waterius
